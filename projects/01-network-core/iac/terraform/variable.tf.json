{
  "variable": {
    "aws_region": {
      "type": "string",
      "default": "us-east-1"
    },
    "account_id": {
      "type": "string",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.account_id))}",
        "error_message": "Use the intended 12-digit sandbox account ID."
      }
    },
    "name": {
      "type": "string",
      "validation": {
        "condition": "${can(regex(\"^[a-z][a-z0-9-]{2,17}$\", var.name))}",
        "error_message": "Use 3\u201318 lowercase letters, digits or hyphens; start with a letter."
      },
      "default": "network-core"
    },
    "alert_email": {
      "type": "string",
      "description": "Optional email subscription; confirm the SNS email after apply.",
      "default": ""
    },
    "azs": {
      "type": "list(string)",
      "validation": {
        "condition": "${length(var.azs) == 2 && length(distinct(var.azs)) == 2}",
        "error_message": "Choose two distinct AZs."
      },
      "default": [
        "us-east-1a",
        "us-east-1b"
      ]
    }
  }
}
